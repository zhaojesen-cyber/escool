{
  "name": "soocoolweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --import tsx scripts/generate-static.tsx",
    "build:client": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "verify:dist": "node --import tsx scripts/verify-dist.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.2.4",
    "wrangler": "4.86.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module"
}
